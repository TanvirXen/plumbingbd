---
import "@fontsource/hind-siliguri/400.css";
import "@fontsource/hind-siliguri/600.css";
import "@fontsource/hind-siliguri/700.css";
import "@fontsource/barlow-condensed/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallButtons from "../components/CallButtons.astro";
import JsonLd from "../components/JsonLd.astro";
import { company } from "../data/company";
import { site } from "../data/sites";
import { graph, organization, website, localBusiness } from "../lib/schema";
import { lp, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string; // path without the /bn prefix, e.g. "/services/x/"
  image?: string; // image key for social sharing
  schema?: object[];
  hasAlt?: boolean; // English/Bangla counterpart exists
  noindex?: boolean;
  canonicalBase?: string; // set to the sister site's URL for pages it owns
  callbar?: boolean; // phone call bar at the bottom (the order page has its own send bar)
}
const { lang, title, description, path, image = site.heroImage, schema = [], hasAlt = true, noindex = false, canonicalBase = site.url, callbar = true } = Astro.props;
const canonical = canonicalBase + lp(lang, path);
const ogImage = `${site.url}/img/${image}-1600.webp`;
const ld = graph(organization(), website(lang), localBusiness(), ...schema);
// Optional, from .env
const gaId = process.env.GA_MEASUREMENT_ID?.trim();
const googleVerify = process.env.GOOGLE_SITE_VERIFICATION?.trim();
const bingVerify = process.env.BING_SITE_VERIFICATION?.trim();
// Where orders are saved for the Order ID (src/scripts/order.ts): Supabase, else the Google Sheet.
const sheetCfg = {
  supabaseUrl: process.env.SUPABASE_URL?.trim().replace(/\/+$/, "") || "",
  supabaseKey: process.env.SUPABASE_ANON_KEY?.trim() || "",
  url: process.env.GOOGLE_SHEET_WEBHOOK_URL?.trim() || "",
  website: site.domain,
  letters: site.orderLetters,
  lang,
  idLabel: lang === "bn" ? "অর্ডার আইডি" : "Order ID",
  idLabelEnquiry: lang === "bn" ? "খরচ জানার আইডি" : "Price Enquiry ID",
};
---
<!doctype html>
<html lang={lang === "bn" ? "bn-BD" : "en-BD"} data-site={site.key}>
<head>
  <meta charset="utf-8" />
  {lang === "en" && path === "/" && (
    // Bangla is the default: the English home page sends visitors to /bn/ unless they picked English.
    // (On Vercel the redirect in vercel.json does this before the page loads; this covers everywhere else.)
    <script is:inline>
      if (/[?&]lang=en(?:&|$)/.test(location.search)) {
        try { localStorage.setItem("lang", "en"); } catch (e) {}
        document.cookie = "lang=en; path=/; max-age=31536000; samesite=lax";
      } else {
        try { var l = localStorage.getItem("lang"); } catch (e) {}
        if (l !== "en" && !/(?:^|; )lang=en(?:;|$)/.test(document.cookie)) location.replace("/bn/" + location.hash);
      }
    </script>
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- The site is already dark: stops Samsung Internet / other browsers' forced "dark mode" from re-colouring it -->
  <meta name="color-scheme" content="dark" />
  <!-- Small fixes for older browsers (old Samsung Internet, UC, Android WebView): runs before the page scripts -->
  <script is:inline>
    (function () {
      var E = window.Element && Element.prototype;
      if (!E) return;
      if (!E.matches) E.matches = E.msMatchesSelector || E.webkitMatchesSelector;
      if (!E.closest) E.closest = function (s) { var el = this; while (el && el.nodeType === 1) { if (el.matches(s)) return el; el = el.parentElement; } return null; };
      if (window.NodeList && !NodeList.prototype.forEach) NodeList.prototype.forEach = Array.prototype.forEach;
      function add(p, a) { for (var i = 0; i < a.length; i++) { var n = a[i]; p.appendChild(typeof n === "string" ? document.createTextNode(n) : n); } }
      if (!E.append) E.append = function () { add(this, arguments); };
      if (!E.replaceChildren) E.replaceChildren = function () { while (this.lastChild) this.removeChild(this.lastChild); add(this, arguments); };
      if (window.AbortController && window.AbortSignal && !AbortSignal.timeout)
        AbortSignal.timeout = function (ms) { var c = new AbortController(); setTimeout(function () { c.abort(); }, ms); return c.signal; };
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  {!noindex && <link rel="canonical" href={canonical} />}
  {hasAlt && !noindex && <link rel="alternate" hreflang="en" href={canonicalBase + lp("en", path)} />}
  {hasAlt && !noindex && <link rel="alternate" hreflang="bn" href={canonicalBase + lp("bn", path)} />}
  {hasAlt && !noindex && <link rel="alternate" hreflang="x-default" href={canonicalBase + lp("bn", path)} />}
  <meta name="theme-color" content="#0B1220" />
  {lang === "bn" && <link rel="preload" href="/fonts/solaiman-lipi.woff2" as="font" type="font/woff2" crossorigin />}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <meta name="application-name" content={lang === "bn" ? `ইমার্জেন্সি ${site.tradeBn}` : `Emergency ${site.trade}`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${company.name} – ${site.division}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === "bn" ? "bn_BD" : "en_US"} />
  <meta name="twitter:card" content="summary_large_image" />
  {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
  {bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
  <JsonLd data={ld} />
  {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
  {gaId && <script is:inline define:vars={{ gaId }}>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag("js", new Date()); gtag("config", gaId);</script>}
  <slot name="head" />
</head>
<body class={callbar ? undefined : "no-callbar"}>
  <Header lang={lang} path={path} hasAlt={hasAlt} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  {callbar && <div class="callbar"><CallButtons lang={lang} compact /></div>}
  <script>
    // Sends Call / WhatsApp click events if Google Analytics (gtag) is added later.
    document.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-track]");
      const g = (window as any).gtag;
      if (el && typeof g === "function") g("event", `${el.dataset.track}_click`, { page_path: location.pathname });
    });
  </script>
  <script type="application/json" id="sheet-cfg" set:html={JSON.stringify(sheetCfg)} />
  <script>import "../scripts/order";</script>
</body>
</html>
