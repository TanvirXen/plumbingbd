---
// One router for every page, in English (/) and Bangla (/bn/). The page list lives in src/lib/routes.ts.
import HomeView from "../views/HomeView.astro";
import HubView from "../views/HubView.astro";
import ServiceView from "../views/ServiceView.astro";
import IndustryView from "../views/IndustryView.astro";
import AreasView from "../views/AreasView.astro";
import AreaView from "../views/AreaView.astro";
import WorkView from "../views/WorkView.astro";
import AboutView from "../views/AboutView.astro";
import ContactView from "../views/ContactView.astro";
import OrderView from "../views/OrderView.astro";
import AmcView from "../views/AmcView.astro";
import GuidesView from "../views/GuidesView.astro";
import GuideView from "../views/GuideView.astro";
import ToolView from "../views/ToolView.astro";
import SitemapView from "../views/SitemapView.astro";
import { getRoutes } from "../lib/routes";
import type { Lang } from "../i18n";

export function getStaticPaths() {
  const strip = (p: string) => p.replace(/^\/|\/$/g, "") || undefined;
  return getRoutes().flatMap((r) => {
    const out = [];
    if (r.en) out.push({ params: { slug: strip(r.path) }, props: { ...r, lang: "en" as Lang } });
    if (r.bn) out.push({ params: { slug: strip(`/bn${r.path}`) }, props: { ...r, lang: "bn" as Lang } });
    return out;
  });
}

const { view, data, lang, path } = Astro.props as { view: string; data?: any; lang: Lang; path: string };
---
{view === "home" && <HomeView lang={lang} />}
{view === "hub" && <HubView lang={lang} kind={data} path={path} />}
{view === "service" && <ServiceView lang={lang} slug={data} />}
{view === "industry" && <IndustryView lang={lang} slug={data} />}
{view === "areas" && <AreasView lang={lang} />}
{view === "area" && <AreaView lang={lang} slug={data} />}
{view === "work" && <WorkView lang={lang} />}
{view === "about" && <AboutView lang={lang} />}
{view === "contact" && <ContactView lang={lang} />}
{view === "order" && <OrderView lang={lang} />}
{view === "amc" && <AmcView lang={lang} />}
{view === "guides" && <GuidesView lang={lang} />}
{view === "guide" && <GuideView lang={lang} slug={data} />}
{view === "tool" && <ToolView lang={lang} path={path} />}
{view === "sitemap" && <SitemapView lang={lang} />}
