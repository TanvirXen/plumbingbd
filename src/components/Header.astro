---
import { company, waLink } from "../data/company";
import { site, sites } from "../data/sites";
import Icon from "./Icon.astro";
import { lp, t, type Lang } from "../i18n";
interface Props { lang: Lang; path: string; hasAlt: boolean }
const { lang, path, hasAlt } = Astro.props;
const enHref = hasAlt ? lp("en", path) : "/";
const bnHref = hasAlt ? lp("bn", path) : "/bn/";
const links = [
  { href: lp(lang, "/services/"), label: t(lang, "services") },
  { href: lp(lang, "/commercial/"), label: t(lang, "business") },
  { href: lp(lang, "/areas/"), label: t(lang, "areasShort") },
  { href: lp(lang, "/work/"), label: t(lang, "work") },
  { href: lp(lang, "/about/"), label: t(lang, "about") },
  { href: lp(lang, "/contact/"), label: t(lang, "contact") },
];
const divisionLink = (key: "electric" | "plumbing") =>
  site.key === key ? lp(lang, "/") : sites[key].url + lp(lang, "/");
const waText = lang === "bn" ? `হ্যালো, আমার ${site.tradeBn} সার্ভিস দরকার। এলাকা: ` : `Hi, I need a ${site.trade.toLowerCase()}. My area: `;
---
<a class="skip" href="#main">{t(lang, "skip")}</a>
<div class="topbar">
  <div class="wrap">
    <nav class="switch" aria-label="Divisions">
      <a href={divisionLink("electric")} aria-current={site.key === "electric" ? "true" : "false"}>⚡ {lang === "bn" ? sites.electric.tradeBn : sites.electric.trade}</a>
      <a href={divisionLink("plumbing")} aria-current={site.key === "plumbing" ? "true" : "false"}>💧 {lang === "bn" ? sites.plumbing.tradeBn : sites.plumbing.trade}</a>
    </nav>
    <div class="langswitch" role="group" aria-label={t(lang, "language")}>
      <a href={enHref} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : "false"} data-lang="en">EN</a>
      <a href={bnHref} hreflang="bn" lang="bn" aria-current={lang === "bn" ? "true" : "false"} data-lang="bn">বাংলা</a>
    </div>
  </div>
</div>
<header class="header">
  <div class="wrap">
    <a class="brand" href={lp(lang, "/")}>
      <img src="/logo-160.webp" width="44" height="44" alt="" />
      <span>
        <b>{lang === "bn" ? `ইমার্জেন্সি ${site.tradeBn}` : `Emergency ${site.trade}`}</b>
        <span>{lang === "bn" ? company.nameBn : company.name}</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-wa header-call" href={waLink(waText)} target="_blank" rel="noopener" data-track="whatsapp"><Icon name="whatsapp" />{t(lang, "whatsapp")}</a>
    <details class="menu">
      <summary>{t(lang, "menu")}</summary>
      <nav class="menu-panel" aria-label="Mobile">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={lp(lang, "/order/")}>{t(lang, "order")}</a>
        <a href={lp(lang, "/guides/")}>{t(lang, "guides")}</a>
      </nav>
    </details>
  </div>
</header>
<script>
  // Remember the visitor's language choice; next time they open the home page, show it in that language.
  document.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((a) =>
    a.addEventListener("click", () => { try { localStorage.setItem("lang", a.dataset.lang!); } catch {} }),
  );
  try {
    const saved = localStorage.getItem("lang");
    if (location.pathname === "/" && saved === "bn") location.replace("/bn/");
    if (location.pathname === "/bn/" && saved === "en") location.replace("/");
  } catch {}
</script>
