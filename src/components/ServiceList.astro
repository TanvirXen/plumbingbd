---
// Service rows: name links to the service page; the green button opens WhatsApp with the service pre-filled.
// Every service has a page on both sites. With `external`, services owned by the sister site link to the
// sister site (cross-domain links); otherwise they link to the local copy. Sister services show their trade icon.
import Icon from "./Icon.astro";
import { bookHref, categoryFor } from "../data/order";
import { site, sites } from "../data/sites";
import { servicePath, type Service } from "../data/services";
import { lp, pick, t, type Lang } from "../i18n";
interface Props { items: Service[]; lang: Lang; two?: boolean; external?: boolean }
const { items, lang, two = true, external = false } = Astro.props;
---
<ul class={two ? "slist two" : "slist"}>
  {items.map((s) => {
    const name = pick(lang, s.name, s.nameBn);
    const foreign = s.site !== site.key;
    const href = (external && foreign ? sites[s.site].url : "") + lp(lang, servicePath(s));
    return (
      <li>
        <a class="sname" href={href}>{foreign && <span aria-hidden="true">{sites[s.site].icon} </span>}{name}</a>
        <a class="swa" href={bookHref(lang, { for: categoryFor(s), s: name })} data-track="book" aria-label={`${t(lang, "bookNow")}: ${name}`}>
          <Icon name="whatsapp" /><span>{t(lang, "book")}</span>
        </a>
      </li>
    );
  })}
</ul>
