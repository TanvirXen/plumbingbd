---
// "Our work" photos as a continuous auto-scrolling strip (same style as northendcoffee.com's photo strip):
// tall rounded cards that glide left in an endless loop. The photos are listed twice so the loop has no jump;
// the copy is hidden from screen readers. With reduced motion it becomes a plain swipeable row.
import Img from "./Img.astro";
import type { Lang } from "../i18n";
interface Props { images: string[]; label: string; lang: Lang }
const { images, label } = Astro.props;
// ~3.4 seconds per photo, like the reference (9 photos in 30s)
const duration = `${Math.max(images.length * 3.4, 12).toFixed(1)}s`;
---
<div class="marquee" aria-label={label} role="region" style={`--marquee-duration:${duration}`}>
  <div class="marquee-track">
    {[0, 1].map((copy) =>
      images.map((g) => (
        <div class="marquee-card" aria-hidden={copy === 1 ? "true" : undefined}>
          <Img name={g} sizes="380px" alt={copy === 1 ? "" : undefined} />
        </div>
      ))
    )}
  </div>
</div>
