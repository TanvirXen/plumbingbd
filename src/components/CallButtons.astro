---
// Main call-to-action: "Book now" opens the booking form (which ends in WhatsApp), phone call second.
import Icon from "./Icon.astro";
import { telLink } from "../data/company";
import { bookHref, type BookParams } from "../data/order";
import { t, type Lang } from "../i18n";
interface Props { lang: Lang; book?: BookParams; label?: string; compact?: boolean; noCall?: boolean }
const { lang, book, label, compact, noCall } = Astro.props;
---
<div class={compact ? "btn-row compact" : "btn-row"}>
  <a class="btn btn-wa" href={bookHref(lang, book)} data-track="book"><Icon name="whatsapp" />{label ?? t(lang, "bookNow")}</a>
  {!noCall && <a class="btn btn-ghost" href={telLink} data-track="call"><Icon name="phone" />{t(lang, compact ? "call" : "callNow")}</a>}
</div>
