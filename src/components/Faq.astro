---
import type { Faq } from "../data/services";
interface Props { items: Faq[]; title?: string }
const { items, title } = Astro.props;
---
{items.length > 0 && (
  <div class="faq">
    {title && <h2>{title}</h2>}
    {items.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
)}
