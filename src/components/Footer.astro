---
// Short footer: contact, main pages, the other division. Full lists live on /services/, /commercial/, /areas/ and /sitemap/.
import { company, telLink, waLink } from "../data/company";
import { sister } from "../data/sites";
import { lp, num, t, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const bn = lang === "bn";
const socialNames: Record<string, string> = {
  googleBusiness: "Google", facebook: "Facebook", youtube: "YouTube", instagram: "Instagram", tiktok: "TikTok",
};
const socials = Object.entries(company.social).filter(([k, v]) => v && k in socialNames);
const year = new Date().getFullYear();
const links = [
  { href: lp(lang, "/services/"), label: t(lang, "services") },
  { href: lp(lang, "/commercial/"), label: t(lang, "business") },
  { href: lp(lang, "/areas/"), label: t(lang, "areasShort") },
  { href: lp(lang, "/about/"), label: t(lang, "about") },
  { href: lp(lang, "/contact/"), label: t(lang, "contact") },
  { href: lp(lang, "/order/"), label: t(lang, "order") },
  { href: lp(lang, "/how-it-works/"), label: t(lang, "howItWorks") },
  { href: lp(lang, "/faq/"), label: t(lang, "faqs") },
];
---
<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>{bn ? company.nameBn : company.name}</h3>
        <p>
          {t(lang, "whatsapp")} / {t(lang, "phone")}: <a href={waLink(bn ? "হ্যালো" : "Hi")} target="_blank" rel="noopener">{company.phone}</a>
          {" · "}<a href={telLink}>{bn ? "কল" : "Call"}</a><br />
          {bn ? company.hours.labelBn : company.hours.label} · {bn ? `${company.address.localityBn}, ${company.address.regionBn}` : `${company.address.locality}, ${company.address.region}`}
        </p>
      </div>
      <nav aria-label={bn ? "ফুটার" : "Footer"}>
        <ul class="flinks">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <p>
          {sister.icon} {t(lang, "otherDivision", { division: bn ? sister.divisionBn : sister.division })}:{" "}
          <a href={sister.url + lp(lang, "/")}>{sister.domain}</a>
        </p>
        {socials.length > 0 && <p>{socials.map(([k, v], i) => <>{i > 0 && " · "}<a href={v} rel="noopener">{socialNames[k]}</a></>)}</p>}
      </div>
    </div>
    <div class="base">
      © {num(lang, String(year))} {bn ? company.nameBn : company.name}{bn ? "।" : "."} {t(lang, "copyright")}
      {" · "}<a href={lp(lang, "/sitemap/")}>{bn ? "সাইটম্যাপ" : "Sitemap"}</a>
    </div>
  </div>
</footer>
