---
// Booking page – same flow as emergencyeps.com (WhatsApp-Order-Flowchart-3). Every "Book" button on the site
// opens this page. Step by step: 1 service · 2 work · 3 when · 4 where & you · 5 check & send.
// Every step can be skipped; "Message us directly" (A) skips the form; Send works from any step. src/scripts/order.ts saves the order in the Google Sheet and adds the Order ID.
// Everything is optional. All chips are drawn by the script below from the config.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { company, waLink } from "../data/company";
import { site } from "../data/sites";
import { areas, uttaraSectors, bashundharaBlocks } from "../data/areas";
import { bookingDays, categoryOptions, orderCategories, timeSlots } from "../data/order";
import { breadcrumbLd } from "../lib/schema";
import { lp, pick, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const bn = lang === "bn";
const L = bn
  ? {
      h1: "সার্ভিস বুক করুন", intro: "৫টি ছোট ধাপ — সব ঐচ্ছিক, যেকোনো ধাপ বাদ দিতে পারেন। শেষে হোয়াটসঅ্যাপ খুলবে, সেন্ড চাপলেই অর্ডার। লগইন লাগবে না।",
      steps: ["সার্ভিস", "কাজ", "কখন", "কোথায়", "পাঠান"],
      what: "কী সার্ভিস দরকার?", review: "দেখে নিন ও পাঠান", back: "পেছনে", next: "পরের ধাপ", skip: "বাদ দিন", stepOf: "ধাপ {n} / {total}",
      directTitle: "তাড়া আছে? ফর্ম বাদ দিন", directText: "সরাসরি হোয়াটসঅ্যাপে মেসেজ করুন:", directBtn: "সরাসরি মেসেজ করুন",
      work: "কী কাজ প্রয়োজন?", issue: "সমস্যার বিবরণ", issueHint: "যেমন: সকাল থেকে রান্নাঘরের ট্যাপ দিয়ে পানি পড়ছে",
      when: "কখন আসব?", date: "তারিখ", time: "সময়", urgent: "জরুরি", urgentNote: "জরুরি = আজই, যত দ্রুত সম্ভব আসব।",
      where: "কোথায় আসব, কাকে কল করব?", area: "এলাকা", pick: "বেছে নিন", address: "ঠিকানা", addressHint: "বাসা, রোড, সেক্টর",
      addLocation: "আমার লোকেশন যোগ করুন", name: "নাম", phone: "মোবাইল নম্বর", phoneErr: "নম্বরটি দেখুন। যেমন: 01712345678",
      remember: "এই ফোনে আমার তথ্য মনে রাখুন", send: "হোয়াটসঅ্যাপে বুকিং পাঠান", clear: "ফর্ম মুছুন",
      previewNote: "শুধু পূরণ করা ঘর পাঠানো হবে। পাঠানোর সময় অর্ডার আইডি যোগ হবে। হোয়াটসঅ্যাপে এডিট করতে পারবেন।",
    }
  : {
      h1: "Book a service", intro: "5 short steps – all optional, skip any of them. WhatsApp opens at the end; tap Send and you are booked. No login.",
      steps: ["Service", "Work", "When", "Where", "Send"],
      what: "What do you need?", review: "Check and send", back: "Back", next: "Next", skip: "Skip", stepOf: "Step {n} of {total}",
      directTitle: "In a hurry? Skip the form", directText: "Message us directly on WhatsApp:", directBtn: "Message us directly",
      work: "What work do you need?", issue: "Issue details", issueHint: "Example: kitchen tap is leaking since morning",
      when: "When should we come?", date: "Date", time: "Time", urgent: "Urgent", urgentNote: "Urgent = today, as soon as possible.",
      where: "Where, and who do we call?", area: "Area", pick: "Choose", address: "Address", addressHint: "House, road, sector",
      addLocation: "Add my location", name: "Name", phone: "Contact number", phoneErr: "Please check the number. Example: 01712345678",
      remember: "Remember my details on this phone", send: "Send booking on WhatsApp", clear: "Clear form",
      previewNote: "Only filled fields are sent. The Order ID is added when you tap Send. You can still edit it in WhatsApp.",
    };
const crumbs = [{ name: t(lang, "breadcrumbHome"), href: lp(lang, "/") }, { name: t(lang, "order"), href: lp(lang, "/order/") }];

// Everything the script needs, in the page language (+ English for the sheet)
const config = {
  lang,
  wa: company.whatsapp,
  defaultCat: site.key,
  days: bookingDays,
  cats: orderCategories.map((c) => ({ key: c.key, letters: c.letters, name: c.name, message: c.message, options: categoryOptions(c) })),
  slots: timeSlots,
  labels: { next: L.next, skip: L.skip, stepOf: L.stepOf },
  t: bn
    ? {
        today: "আজ", tomorrow: "আগামীকাল", urgent: "জরুরি", gettingLocation: "লোকেশন খোঁজা হচ্ছে…", locationAdded: "লোকেশন যোগ হয়েছে", remove: "মুছুন",
        locationDenied: "লোকেশন বন্ধ আছে। এই সাইটে লোকেশন চালু করুন, অথবা ঠিকানা লিখুন।", locationFailed: "লোকেশন পাওয়া যায়নি। অনুগ্রহ করে ঠিকানা লিখুন।",
        jobs: "টি কাজ", msgUrgent: "*জরুরি – দ্রুত আসুন*", msgService: "সার্ভিস", msgWork: "কাজ", msgIssue: "সমস্যা", msgName: "নাম", msgContact: "যোগাযোগ",
        msgArea: "এলাকা", msgAddress: "ঠিকানা", msgLocation: "লোকেশন", msgDate: "তারিখ", msgTime: "সময়", msgFooter: "ওয়েবসাইট থেকে পাঠানো",
      }
    : {
        today: "Today", tomorrow: "Tomorrow", urgent: "Urgent", gettingLocation: "Finding your location…", locationAdded: "Location added", remove: "Remove",
        locationDenied: "Location is blocked. Allow location for this site, or just write your address.", locationFailed: "Could not find your location. Please write your address.",
        jobs: "jobs", msgUrgent: "*URGENT – PLEASE COME ASAP*", msgService: "Service", msgWork: "Work", msgIssue: "Issue", msgName: "Name", msgContact: "Contact",
        msgArea: "Area", msgAddress: "Address", msgLocation: "Location", msgDate: "Date", msgTime: "Time", msgFooter: "Sent from website",
      },
};
const first = orderCategories.find((c) => c.key === site.key)!;
---
<Base lang={lang} title={`${L.h1} | ${bn ? `ইমার্জেন্সি ${site.tradeBn}` : `Emergency ${site.trade}`}`} description={L.intro} path="/order/"
  schema={[breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: site.url + c.href })))]}>
  <div class="wrap page-head"><Breadcrumbs items={crumbs} /></div>
  <section class="wrap book">
    <h1>{L.h1}</h1>
    <p class="lead">{L.intro}</p>

    <div class="direct" id="direct">
      <div>
        <b>{L.directTitle}</b>
        <p class="muted small">{L.directText} <span class="direct-msg" id="quick-msg">“{pick(lang, first.message.en, first.message.bn)}”</span></p>
      </div>
      <a class="btn btn-wa btn-sm" id="quick" href={waLink(pick(lang, first.message.en, first.message.bn))} target="_blank" rel="noopener"
        data-order={JSON.stringify({ letters: first.letters, service: first.name.en, orderType: "WhatsApp (A)" })} data-track="whatsapp_quick">
        <Icon name="whatsapp" />{L.directBtn}
      </a>
    </div>

    <ol class="book-progress" id="progress" aria-label={bn ? "ধাপ" : "Steps"}>
      {L.steps.map((s, i) => <li><button type="button" data-go={i}><span>{i + 1}</span>{s}</button></li>)}
    </ol>

    <form class="form book-form" id="order" novalidate>
      <section class="step" data-step="0">
        <h2 class="book-h"><span class="num">1</span>{L.what}</h2>
        <div class="cat-grid" id="cats" role="radiogroup" aria-label={L.what}>
          {orderCategories.map((c) => (
            <button type="button" class="cat" role="radio" aria-checked={c.key === site.key ? "true" : "false"} data-cat={c.key}>
              <span class="cat-icon" aria-hidden="true">{c.icon}</span>
              <b>{pick(lang, c.name.en, c.name.bn)}</b>
              <span>{pick(lang, c.short.en, c.short.bn)}</span>
            </button>
          ))}
        </div>
      </section>

      <section class="step" data-step="1">
        <h2 class="book-h"><span class="num">2</span>{L.work}</h2>
        <div class="pick" id="work"></div>
        <label>{L.issue}
          <textarea name="issue" maxlength="500" rows="3" placeholder={L.issueHint}></textarea>
          <span class="count" id="issue-count">0 / 500</span>
        </label>
      </section>

      <section class="step" data-step="2">
        <h2 class="book-h"><span class="num">3</span>{L.when}</h2>
        <p class="pick-title">{L.time}</p>
        <div class="pick" id="times"></div>
        <p class="muted small urgent-note" id="urgent-note" hidden>⚡ {L.urgentNote}</p>
        <p class="pick-title">{L.date}</p>
        <div class="pick" id="dates"></div>
      </section>

      <section class="step" data-step="3">
        <h2 class="book-h"><span class="num">4</span>{L.where}</h2>
        <div class="row2">
          <label>{L.area}
            <select name="area">
              <option value="">{L.pick}</option>
              {areas.map((a) => <option>{pick(lang, a.name, a.nameBn)}</option>)}
              <optgroup label={bn ? "উত্তরার সেক্টর" : "Uttara sectors"}>{uttaraSectors.map((a) => <option>{pick(lang, a.name, a.nameBn)}</option>)}</optgroup>
              <optgroup label={bn ? "বসুন্ধরার ব্লক" : "Bashundhara blocks"}>{bashundharaBlocks.map((a) => <option>{pick(lang, a.name, a.nameBn)}</option>)}</optgroup>
            </select>
          </label>
          <label>{L.address}<input name="address" autocomplete="street-address" maxlength="200" placeholder={L.addressHint} /></label>
        </div>
        <div class="loc" id="loc">
          <button type="button" class="btn btn-ghost btn-sm" id="loc-add"><Icon name="pin" />{L.addLocation}</button>
        </div>
        <div class="row2">
          <label>{L.name}<input name="name" autocomplete="name" maxlength="80" /></label>
          <label>{L.phone}
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" placeholder="01XXXXXXXXX" />
            <em class="field-error" id="phone-err" hidden>{L.phoneErr}</em>
          </label>
        </div>
        <label class="check small-check"><input type="checkbox" name="remember" /> {L.remember}</label>
      </section>

      <section class="step" data-step="4">
        <h2 class="book-h"><span class="num">5</span>{L.review}</h2>
        <div class="wa-preview" aria-live="polite">
          <div class="wa-chat"><div class="wa-bubble out" id="preview"></div></div>
          <p class="muted small">{L.previewNote}</p>
        </div>
        <button type="button" class="link-btn" id="clear">{L.clear}</button>
      </section>

      <div class="step-nav" id="step-nav">
        <button type="button" class="btn btn-ghost btn-sm" id="back">← {L.back}</button>
        <span class="step-of" id="step-of"></span>
        <button type="button" class="btn btn-accent btn-sm" id="next">{L.skip} →</button>
      </div>

      <div class="book-send">
        <p class="book-summary" id="summary"></p>
        <a class="btn btn-wa btn-big" id="send" href="#" data-order="{}" data-track="whatsapp_order"><Icon name="whatsapp" />{L.send}</a>
      </div>
    </form>
  </section>
  <script type="application/json" id="order-config" set:html={JSON.stringify(config)} />
</Base>
<script>
  type Text = { en: string; bn: string };
  type Cat = { key: string; letters: string; name: Text; message: Text; options: Text[] };
  type Slot = { start: number; end: number } & Text;
  const cfg = JSON.parse(document.getElementById("order-config")!.textContent!);
  const lang: "en" | "bn" = cfg.lang;
  const T = cfg.t;
  const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
  const form = $<HTMLFormElement>("order");
  const send = $<HTMLAnchorElement>("send");
  const quick = $<HTMLAnchorElement>("quick");
  const steps = [...document.querySelectorAll<HTMLElement>(".step")];
  const back = $<HTMLButtonElement>("back");
  const next = $<HTMLButtonElement>("next");
  const PHONE_RE = /^(?:\+?88)?01[3-9]\d{8}$/;
  const STORE = "booking-details";
  const URGENT = "urgent";

  // ---------- State ----------
  const params = new URLSearchParams(location.search);
  const cats: Cat[] = cfg.cats;
  let cat: Cat = cats.find((c) => c.key === params.get("for")) ?? cats.find((c) => c.key === cfg.defaultCat) ?? cats[0];
  let work: string[] = [];
  let date: string | undefined;
  let time: string | undefined;
  let location_: string | undefined;
  let step = 0;
  let done: boolean[] = [];

  // ---------- Dates (Dhaka time) ----------
  const TZ = "Asia/Dhaka";
  const DAY = 86_400_000;
  const dayKey = (d: Date) => new Intl.DateTimeFormat("en-CA", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit" }).format(d);
  const keyDate = (k: string) => new Date(`${k}T12:00:00+06:00`);
  const hourNow = () => Number(new Intl.DateTimeFormat("en-GB", { timeZone: TZ, hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  const locale = lang === "bn" ? "bn-BD" : "en-GB";
  const today = dayKey(new Date());
  const dates = Array.from({ length: cfg.days }, (_, i) => dayKey(new Date(keyDate(today).getTime() + i * DAY)));
  function dateLabel(k: string): string {
    const d = keyDate(k);
    const dm = new Intl.DateTimeFormat(locale, { timeZone: TZ, day: "numeric", month: "short" }).format(d);
    const i = dates.indexOf(k);
    if (i === 0) return `${T.today}, ${dm}`;
    if (i === 1) return `${T.tomorrow}, ${dm}`;
    return `${new Intl.DateTimeFormat(locale, { timeZone: TZ, weekday: "short" }).format(d)}, ${dm}`;
  }
  const slotId = (s: Slot) => `${s.start}-${s.end}`;
  const slot = (id?: string): Slot | undefined => cfg.slots.find((s: Slot) => slotId(s) === id);
  const timeText = (id: string | undefined, l: "en" | "bn") => (id === URGENT ? (l === "en" ? "Urgent" : T.urgent) : slot(id)?.[l]);

  // ---------- Chips ----------
  function chip(label: string, pressed: boolean, onClick: () => void, extra = "", disabled = false) {
    const b = document.createElement("button");
    b.type = "button";
    b.className = `chip ${extra}`.trim();
    b.textContent = label;
    b.setAttribute("aria-pressed", String(pressed));
    b.disabled = disabled;
    b.addEventListener("click", onClick);
    return b;
  }
  function drawCats() {
    document.querySelectorAll<HTMLButtonElement>("#cats .cat").forEach((b) => b.setAttribute("aria-checked", String(b.dataset.cat === cat.key)));
    const msg = cat.message[lang];
    $("quick-msg").textContent = `“${msg}”`;
    quick.href = `https://wa.me/${cfg.wa}?text=${encodeURIComponent(msg)}`;
    quick.dataset.order = JSON.stringify({ letters: cat.letters, service: cat.name.en, orderType: "WhatsApp (A)" });
  }
  function drawWork() {
    $("work").replaceChildren(...cat.options.map((o) =>
      chip(o[lang], work.includes(o.en), () => {
        work = work.includes(o.en) ? work.filter((w) => w !== o.en) : [...work, o.en];
        drawWork(); update();
      }),
    ));
  }
  function drawWhen() {
    $("dates").replaceChildren(...dates.map((d) =>
      chip(dateLabel(d), date === d, () => {
        date = date === d ? undefined : d;
        if (date && date !== today && time === URGENT) time = undefined; // urgent is always today
        drawWhen(); update();
      }),
    ));
    const passed = (s: Slot) => (date ?? today) === today && hourNow() >= s.end;
    if (time && time !== URGENT && slot(time) && passed(slot(time)!)) time = undefined;
    $("times").replaceChildren(
      chip(`⚡ ${T.urgent}`, time === URGENT, () => {
        time = time === URGENT ? undefined : URGENT;
        if (time === URGENT) date = today;
        drawWhen(); update();
      }, "chip-urgent"),
      ...cfg.slots.map((s: Slot) => chip(s[lang], time === slotId(s), () => {
        time = time === slotId(s) ? undefined : slotId(s);
        drawWhen(); update();
      }, "", passed(s))),
    );
    $("urgent-note").hidden = time !== URGENT;
  }

  // ---------- Location ----------
  function drawLoc(state: "idle" | "loading" | "denied" | "failed" = "idle") {
    const box = $("loc");
    if (location_) {
      box.innerHTML = "";
      const a = Object.assign(document.createElement("a"), { href: `https://maps.google.com/?q=${location_}`, target: "_blank", rel: "noopener", textContent: `✓ ${T.locationAdded}` });
      const rm = chip(T.remove, false, () => { location_ = undefined; drawLoc(); update(); }, "link-btn");
      box.append(a, " ", rm);
      return;
    }
    const btn = box.querySelector<HTMLButtonElement>("#loc-add") ?? addBtn;
    if (!box.contains(btn)) box.replaceChildren(btn);
    btn.disabled = state === "loading";
    btn.lastChild!.textContent = state === "loading" ? T.gettingLocation : addText;
    box.querySelector(".field-error")?.remove();
    if (state === "denied" || state === "failed") {
      const e = Object.assign(document.createElement("em"), { className: "field-error", textContent: state === "denied" ? T.locationDenied : T.locationFailed });
      box.append(e);
    }
  }
  const addBtn = $<HTMLButtonElement>("loc-add");
  const addText = addBtn.lastChild!.textContent!;
  addBtn.addEventListener("click", () => {
    if (!("geolocation" in navigator)) return drawLoc("failed");
    drawLoc("loading");
    navigator.geolocation.getCurrentPosition(
      (p) => { location_ = `${p.coords.latitude.toFixed(5)},${p.coords.longitude.toFixed(5)}`; drawLoc(); update(); },
      (err) => drawLoc(err.code === err.PERMISSION_DENIED ? "denied" : "failed"),
      { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 },
    );
  });

  // ---------- Message + sheet row ----------
  const val = (name: string) => String(new FormData(form).get(name) ?? "").replace(/\s+/g, " ").trim() || undefined;
  function build() {
    const lines: string[] = [];
    const add = (label: string, v?: string) => v && lines.push(`*${label}:* ${v}`);
    if (time === URGENT) lines.push(T.msgUrgent);
    add(T.msgService, cat.name[lang]);
    add(T.msgWork, cat.options.filter((o) => work.includes(o.en)).map((o) => o[lang]).join(", "));
    add(T.msgIssue, val("issue"));
    add(T.msgName, val("name"));
    add(T.msgContact, val("phone"));
    add(T.msgArea, val("area"));
    add(T.msgAddress, val("address"));
    if (location_) add(T.msgLocation, `https://maps.google.com/?q=${location_}`);
    if (date) add(T.msgDate, dateLabel(date));
    add(T.msgTime, timeText(time, lang));
    lines.push(T.msgFooter);
    return lines.join("\n");
  }
  function update() {
    const msg = build();
    send.href = `https://wa.me/${cfg.wa}?text=${encodeURIComponent(msg)}`;
    send.dataset.order = JSON.stringify({
      letters: cat.letters, orderType: "Order form (B)", service: cat.name.en,
      work: cat.options.filter((o) => work.includes(o.en)).map((o) => o.en).join(", ") || undefined,
      issue: val("issue"), name: val("name"), contact: val("phone"),
      address: [val("address"), val("area")].filter(Boolean).join(", ") || undefined,
      location: location_ && `https://maps.google.com/?q=${location_}`,
      date: time === URGENT ? undefined : date, time: timeText(time, "en"), urgent: time === URGENT,
    });

    // WhatsApp-style preview: *bold* like WhatsApp
    const pv = $("preview");
    pv.replaceChildren(...msg.split("\n").map((line) => {
      const div = document.createElement("div");
      line.split(/(\*[^*]+\*)/g).forEach((part) => {
        if (part.length > 2 && part.startsWith("*") && part.endsWith("*")) div.append(Object.assign(document.createElement("strong"), { textContent: part.slice(1, -1) }));
        else if (part) div.append(part);
      });
      return div;
    }));

    // Progress: a step lights up once something is filled in
    done = [true, work.length > 0 || !!val("issue"), !!(date || time), !!(val("area") || val("address") || location_ || val("name") || val("phone")), false];
    drawSteps();

    // Summary next to the Send button
    const bits = [cat.name[lang]];
    if (work.length) bits.push(`${lang === "bn" ? work.length.toLocaleString("bn-BD") : work.length} ${T.jobs}`);
    if (time === URGENT) bits.push(`⚡ ${T.urgent}`);
    else if (date || time) bits.push([date && dateLabel(date), timeText(time, lang)].filter(Boolean).join(" · "));
    $("summary").textContent = bits.join(" · ");

    $("issue-count").textContent = `${(val("issue") ?? "").length} / 500`;
  }

  // ---------- Steps (all skippable) ----------
  const LT = cfg.labels;
  function drawSteps() {
    steps.forEach((el, i) => (el.hidden = i !== step));
    document.querySelectorAll<HTMLElement>("#progress li").forEach((li, i) => {
      li.classList.toggle("done", done[i] && i !== step);
      li.querySelector("button")!.toggleAttribute("aria-current", i === step);
      if (i === step) li.querySelector("button")!.setAttribute("aria-current", "step");
    });
    back.hidden = step === 0;
    next.hidden = step === steps.length - 1;
    next.textContent = `${done[step] ? LT.next : LT.skip} →`;
    next.classList.toggle("btn-accent", !!done[step]);
    next.classList.toggle("btn-ghost", !done[step]);
    const n = (x: number) => (lang === "bn" ? x.toLocaleString("bn-BD") : String(x));
    $("step-of").textContent = LT.stepOf.replace("{n}", n(step + 1)).replace("{total}", n(steps.length));
  }
  function go(to: number) {
    step = Math.max(0, Math.min(steps.length - 1, to));
    drawSteps();
    const top = $("progress").getBoundingClientRect().top;
    if (top < 0 || top > innerHeight * 0.6) $("progress").scrollIntoView({ behavior: "smooth", block: "start" });
    steps[step].querySelector<HTMLElement>("button, input, textarea, select")?.focus({ preventScroll: true });
  }
  next.addEventListener("click", () => go(step + 1));
  back.addEventListener("click", () => go(step - 1));
  document.querySelectorAll<HTMLButtonElement>("#progress [data-go]").forEach((b) => b.addEventListener("click", () => go(Number(b.dataset.go))));
  document.documentElement.classList.add("wizard");

  // ---------- Phone check ----------
  const phone = form.elements.namedItem("phone") as HTMLInputElement;
  const phoneOk = () => !phone.value.trim() || PHONE_RE.test(phone.value.replace(/[\s-]/g, ""));
  phone.addEventListener("blur", () => { $("phone-err").hidden = phoneOk(); phone.setAttribute("aria-invalid", String(!phoneOk())); });
  phone.addEventListener("input", () => { if (phoneOk()) { $("phone-err").hidden = true; phone.removeAttribute("aria-invalid"); } });

  // ---------- Remember details (this browser only) ----------
  const remember = form.elements.namedItem("remember") as HTMLInputElement;
  const KEEP = ["name", "phone", "area", "address"];
  try {
    const saved = JSON.parse(localStorage.getItem(STORE) || "null");
    if (saved) {
      KEEP.forEach((k) => { if (saved[k]) (form.elements.namedItem(k) as HTMLInputElement).value = saved[k]; });
      remember.checked = true;
    }
  } catch { /* storage blocked */ }
  function saveDetails() {
    try {
      if (remember.checked) localStorage.setItem(STORE, JSON.stringify(Object.fromEntries(KEEP.map((k) => [k, val(k) ?? ""]))));
      else localStorage.removeItem(STORE);
    } catch { /* storage blocked */ }
  }

  // ---------- Events ----------
  document.querySelectorAll<HTMLButtonElement>("#cats .cat").forEach((b) => b.addEventListener("click", () => {
    if (cat.key !== b.dataset.cat) {
      cat = cats.find((c) => c.key === b.dataset.cat)!;
      work = [];
      drawCats(); drawWork(); update();
    }
    setTimeout(() => go(1), 180); // show the tick, then move on
  }));
  form.addEventListener("input", update);
  form.addEventListener("change", update);
  // Runs before src/scripts/order.ts (which listens on document) – stop a bad number before it is sent
  send.addEventListener("click", (e) => {
    if (!phoneOk()) {
      e.preventDefault();
      e.stopPropagation();
      $("phone-err").hidden = false;
      go(3);
      phone.focus();
      return;
    }
    saveDetails();
  });
  $("clear").addEventListener("click", () => {
    form.reset();
    work = []; date = undefined; time = undefined; location_ = undefined;
    try { localStorage.removeItem(STORE); } catch { /* storage blocked */ }
    drawWork(); drawWhen(); drawLoc(); update();
    go(0);
  });

  // From a Book button: /order/?for=plumbing&s=Basin%20Installation&area=Uttara
  const s = params.get("s");
  if (s) (form.elements.namedItem("issue") as HTMLTextAreaElement).value = s.slice(0, 200);
  const area = params.get("area");
  const areaSel = form.elements.namedItem("area") as HTMLSelectElement;
  if (area && [...areaSel.options].some((o) => o.value === area)) areaSel.value = area;
  if (params.get("for")) step = 1; // service already chosen on the page they came from

  drawCats(); drawWork(); drawWhen(); update();
  setInterval(() => drawWhen(), 60_000); // grey out slots as time passes
</script>
