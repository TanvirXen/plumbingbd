---
// /order/ – choose a service (same as emergencyeps.com): "Order now" (direct WhatsApp) or one of the 5 services.
// Each service opens its own order page /order/<service>/ (OrderServiceView).
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import { site } from "../data/sites";
import { orderText } from "../data/order";
import { breadcrumbLd } from "../lib/schema";
import { lp, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const bn = lang === "bn";
const T = orderText[lang];
const crumbs = [{ name: t(lang, "breadcrumbHome"), href: lp(lang, "/") }, { name: t(lang, "order"), href: lp(lang, "/order/") }];
---
<Base lang={lang} title={`${T.chooseService} | ${bn ? `ইমার্জেন্সি ${site.tradeBn}` : `Emergency ${site.trade}`}`} description={T.heroText} path="/order/"
  schema={[breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: site.url + c.href })))]}>
  <div class="wrap page-head"><Breadcrumbs items={crumbs} /></div>
  <section class="eps" style="padding-bottom:3rem">
    <div class="wrap">
      <h1 style="font-size:clamp(1.7rem,5vw,2.4rem);font-weight:700">{T.chooseService}</h1>
      <p class="muted">{T.heroText}</p>
      <ServiceGrid lang={lang} />
    </div>
  </section>
</Base>
