---
import Base from "../layouts/Base.astro";
import WorkCarousel from "../components/WorkCarousel.astro";
import EpsIcon from "../components/EpsIcon.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import { company, telLink, waLink } from "../data/company";
import { orderNow, orderText, trendingItems } from "../data/order";
import { site } from "../data/sites";
import { lp, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const bn = lang === "bn";
const T = orderText[lang];
const Work = site.work[0].toUpperCase() + site.work.slice(1);
const gallery = site.key === "electric"
  ? ["fan-install-1", "panel-3", "chandelier-1", "socket-2", "panel-room-1", "light-1", "panel-7", "drilling-2", "supershop-2"]
  : ["kitchen-sink", "commode-1", "tap-1", "pipe-1", "commode-2", "supershop-1", "socket-3", "supershop-3", "panel-room-2"];

// Why choose us: six short reasons, from the company's real way of working.
const why = bn
  ? [
      { icon: "clock", title: "দ্রুত পৌঁছাই", text: "উত্তরায় ৩০ মিনিট, মিরপুর ও বসুন্ধরায় ১ ঘণ্টা, ঢাকার অন্যান্য এলাকায় ২ ঘণ্টা।" },
      { icon: "phone", title: "২৪ ঘণ্টা, ৭ দিন খোলা", text: "দিন-রাত যেকোনো সময় কল বা হোয়াটসঅ্যাপ করুন।" },
      { icon: "user", title: "ইঞ্জিনিয়ারের নেতৃত্বে নিজস্ব টিম", text: "ইলেকট্রিক্যাল ইঞ্জিনিয়ারের নেতৃত্বে প্রশিক্ষিত টেকনিশিয়ান, কোম্পানির ইউনিফর্মে। আসার আগেই নাম ও নম্বর পাঠাই।" },
      { icon: "tag", title: "আগে খরচ ঠিক", text: "কাজ শুরুর আগে খরচ জানাই ও কাজ ঠিক করে নিই। পরে কোনো চমক নেই।" },
      { icon: "wallet", title: "কাজ শেষে পেমেন্ট", text: "কাজ সম্পূর্ণ হলে পেমেন্ট করুন: ক্যাশ, বিকাশ, নগদ বা NPSB ব্যাংক ট্রান্সফার।" },
      { icon: "shield", title: "অর্ডার আইডিতে ভরসা", text: "প্রতিটি কাজের অর্ডার আইডি থাকে। আমাদের কাজের একই সমস্যা আবার হলে মেসেজ দিন, আমরা এসে দেখব।" },
    ]
  : [
      { icon: "clock", title: "Fast arrival", text: "Uttara in 30 minutes, Mirpur and Bashundhara in 1 hour, other areas of Dhaka in 2 hours." },
      { icon: "phone", title: "Open 24 hours, 7 days", text: "Call or WhatsApp us any time, day or night." },
      { icon: "user", title: "Engineer-led, our own team", text: "Trained technicians in company uniform, led by an electrical engineer. You get their name and number before the visit." },
      { icon: "tag", title: "Cost agreed first", text: "We tell you the cost and agree on the work before we start. No surprises later." },
      { icon: "wallet", title: "Pay after completion of work", text: "Pay once the work is completed: cash, bKash, Nagad or NPSB bank transfer." },
      { icon: "shield", title: "Backed by your Order ID", text: "Every job has an Order ID. If the same problem comes back from our work, message us and we come to check." },
    ];

// Arrival times: a slim ticker under the menu that scrolls right to left.
const eta = bn
  ? [
      { area: "উত্তরা (সব সেক্টর)", time: "৩০ মিনিট", key: true },
      { area: "বসুন্ধরা আ/এ (সব ব্লক)", time: "১ ঘণ্টা", key: true },
      { area: "মিরপুর", time: "১ ঘণ্টা" },
      { area: "ঢাকা শহরের অন্যান্য এলাকা", time: "২ ঘণ্টা" },
    ]
  : [
      { area: "Uttara (all sectors)", time: "30 minutes", key: true },
      { area: "Bashundhara R/A (all blocks)", time: "1 hour", key: true },
      { area: "Mirpur", time: "1 hour" },
      { area: "Other areas of Dhaka City", time: "2 hours" },
    ];

// Trending services: a ticker at the bottom of the hero, scrolling right to left (like the arrival-time bar).
// All items look the same. The "Trending Services" and "Checkup" labels move with the text and open their own order forms.
const showTrending = true;
// The list lives in src/data/order.ts (trendingItems): winter jobs first, then everyday favourites, electric and plumbing balanced.
const trending = trendingItems;
const trendHref = (x: (typeof trending)[number]) =>
  `${lp(lang, `/order/${x.cat}/`)}?${new URLSearchParams({ work: x.work.join("|"), s: x[lang] })}`;

const title = bn
  ? `${site.tradeBn} উত্তরা ও বসুন্ধরা — বাসা ও অফিস | ${company.nameBn}`
  : `${site.trade} in Uttara & Bashundhara — Home & Corporate | ${company.name}`;
const description = bn
  ? `উত্তরা, বসুন্ধরা ও আশেপাশে বাসা, অফিস ও প্রতিষ্ঠানের ${site.workBn} কাজ। হোয়াটসঅ্যাপে বুক করুন ${company.phone}।`
  : `${site.trade} for homes, offices and businesses in Uttara, Bashundhara and north Dhaka. Book on WhatsApp ${company.phone}.`;
// Hero picture: electrician poster on the electric site, plumber poster on the plumber site.
// Phones show it lower down (after the Trending and Checkup bars), desktops beside the hero text.
const poster = site.key === "electric"
  ? { src: "/img/hero-electric-800.webp", srcset: "/img/hero-electric-480.webp 480w, /img/hero-electric-800.webp 800w, /img/hero-electric-1200.webp 1200w",
      sizes: "(max-width: 760px) 92vw, 500px", width: 800, height: 725,
      alt: bn ? "ইমার্জেন্সি ইলেকট্রিক এন্ড প্লাম্বিং সার্ভিসের টেকনিশিয়ান, ইলেকট্রিক প্যানেলের সামনে — ২৪/৭ সেবা" : "Emergency Electric and Plumbing Service technician in front of an electrical panel — 24/7 service" }
  : { src: "/img/hero-plumber-800.webp", srcset: "/img/hero-plumber-480.webp 480w, /img/hero-plumber-800.webp 800w, /img/hero-plumber-1200.webp 1200w",
      sizes: "(max-width: 760px) 92vw, 500px", width: 800, height: 731,
      alt: bn ? "ইমার্জেন্সি ইলেকট্রিক এন্ড প্লাম্বিং সার্ভিসের প্লাম্বার, রান্নাঘরের ট্যাপ লাগাচ্ছেন — ২৪/৭ সেবা" : "Emergency Electric and Plumbing Service plumber fitting a kitchen tap — 24/7 service" };
---
<Base lang={lang} title={title} description={description} path="/">

  <!-- ONE moving bar under the menu: Checkup offer, Trending services, then arrival times -->
  <div class="eps one-bar">
    <div class="wrap">
      <div class="ticker" role="region" aria-label={bn ? "অফার, ট্রেন্ডিং সার্ভিস ও পৌঁছানোর সময়" : "Offer, trending services and arrival times"} tabindex="0">
        {[0, 1].map((k) => (
          <ul class="ticker-list one-list" aria-hidden={k === 1 ? "true" : undefined}>
            <li><a class="ob-tag ob-check" href={lp(lang, "/order/checkup/")} tabindex={k === 1 ? "-1" : undefined}><EpsIcon name="check" /> {bn ? "চেকআপ" : "Checkup"}</a></li>
            <li><a class="ob-item" href={lp(lang, "/order/checkup/")} tabindex="-1">{T.checkupBar[0]}<b>{T.checkupBar[1]}</b></a></li>
            <li><a class="ob-tag ob-trend" href={lp(lang, "/order/trending/")} tabindex={k === 1 ? "-1" : undefined}><EpsIcon name="trend" /> {bn ? "ট্রেন্ডিং" : "Trending"}</a></li>
            {trending.slice(0, 8).map((x) => <li><a class="ob-item" href={trendHref(x)} tabindex="-1">{x[lang]}</a></li>)}
            <li><span class="ob-tag ob-eta"><EpsIcon name="clock" /> {bn ? "পৌঁছাই" : "We reach"}</span></li>
            {eta.map((a) => <li><a class={a.key ? "ob-item ob-key" : "ob-item"} href="#choose" tabindex="-1">{a.area} <b>{a.time}</b></a></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>

  <!-- Hero: photo as background, one main button -->
  <section class="eps hero2" style={`--hero-img:url(${poster.src.replace("-800", "-1200")})`}>
    <div class="wrap hero2-inner">
      <a class="g-rating" href={company.social.googleReview} target="_blank" rel="noopener"><span class="stars">★★★★★</span> <b>5.0</b> · {bn ? "৯৮টি গুগল রিভিউ" : "98 Google reviews"}</a>
      <h1 class="hero-name">{bn
        ? <>ইমার্জেন্সি <span class="hn-yellow">ইলেকট্রিক</span> এন্ড <span class="hn-blue">প্লাম্বিং</span> সার্ভিস</>
        : <>Emergency <span class="hn-yellow">Electric</span> and <span class="hn-blue">Plumbing</span> Service</>}</h1>
      <p class="lead">{bn ? "২৪ ঘণ্টা সেবা · উত্তরা ৩০ মিনিট · বসুন্ধরা ১ ঘণ্টা · কাজ শেষে পেমেন্ট" : "Open 24 hours · Uttara 30 min · Bashundhara 1 hour · Pay after the work"}</p>
      <a class="btn btn-main" href="#choose" data-track="hero_order_now"><EpsIcon name="whatsapp" /> {T.orderNow}</a>
      <p class="hero2-links">
        <a href="?enquiry=1#choose" data-enquiry><EpsIcon name="tag" /> {T.priceEnquiry}</a>
        <span aria-hidden="true">·</span>
        <a href={telLink}><EpsIcon name="phone" /> {T.callUs}</a>
      </p>
    </div>
  </section>

  <section class="eps eps-section" id="choose">
    <div class="wrap">
      <h2 data-choose-title data-t-order={T.chooseService} data-t-enquiry={T.chooseEnquiry}>{T.chooseService}</h2>
      <ServiceGrid lang={lang} />
    </div>
  </section>

  <!-- Why choose us: real company facts only (arrival times, 24/7, engineer-led team, cost first, pay after, Order ID) -->
  <section class="eps eps-section why" aria-labelledby="why-title">
    <div class="wrap">
      <p class="why-eyebrow"><EpsIcon name="shield" /> {bn ? "আমাদের প্রতিশ্রুতি" : "Our promise"}</p>
      <h2 id="why-title">{bn ? "কেন আমাদের বেছে নেবেন" : "Why Choose Us"}</h2>
      <p class="why-sub">{bn ? "ইলেকট্রিক, প্লাম্বিং, এসি ও বাসার মেরামত — ঢাকায় এক বিশ্বস্ত টিম।" : "Electric, plumbing, AC and home repairs — one trusted team in Dhaka."}</p>
      <ul class="why-grid">
        {why.map((w) => (
          <li class="why-card">
            <span class="why-icon"><EpsIcon name={w.icon} /></span>
            <div><h3>{w.title}</h3><p>{w.text}</p></div>
          </li>
        ))}
      </ul>
      <div class="why-cta">
        <p>{bn ? "আজই সমস্যার সমাধান করুন।" : "Get it fixed today."}</p>
        <div class="btn-row">
          <a class="btn btn-green" href={lp(lang, "/services/")} data-track="why_order_now"><EpsIcon name="whatsapp" /> {T.orderNow}</a>
          <a class="btn btn-enquiry" href="?enquiry=1#choose" data-enquiry data-track="why_price_enquiry"><EpsIcon name="tag" /> {T.priceEnquiry}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Business, the full service list, how it works and FAQ each have their own page; the home page only links to them -->
  <section class="eps eps-section" style="padding-top:0">
    <div class="wrap">
      <div class="service-grid two">
        <a class="service" href={lp(lang, "/commercial/")}>
          <span class="service-icon"><EpsIcon name="building" /></span>
          <span class="service-name">{bn ? `প্রতিষ্ঠানের জন্য ${site.workBn}` : `${Work} for businesses`}</span>
          <span class="service-short">{bn ? "অফিস, দোকান, রেস্টুরেন্ট, ক্লিনিক — সাইট সার্ভে ও মাসিক চুক্তি" : "Offices, shops, restaurants, clinics — surveys and monthly contracts"}</span>
          <EpsIcon name="arrow" class="service-arrow" />
        </a>
        <a class="service" href={lp(lang, "/services/")}>
          <span class="service-icon"><EpsIcon name="house" /></span>
          <span class="service-name">{bn ? "বাসার সব সার্ভিস" : "All services for your home"}</span>
          <span class="service-short">{bn ? "আমরা যত কাজ করি তার পুরো তালিকা" : "The full list of jobs we do"}</span>
          <EpsIcon name="arrow" class="service-arrow" />
        </a>
        <a class="service" href={lp(lang, "/how-it-works/")}>
          <span class="service-icon"><EpsIcon name="steps" /></span>
          <span class="service-name">{t(lang, "howItWorks")}</span>
          <span class="service-short">{bn ? "মেসেজ, টেকনিশিয়ান আসে, কাজ শেষে পেমেন্ট" : "Message, a technician comes, pay after the job"}</span>
          <EpsIcon name="arrow" class="service-arrow" />
        </a>
        <a class="service" href={lp(lang, "/faq/")}>
          <span class="service-icon"><EpsIcon name="help" /></span>
          <span class="service-name">{t(lang, "faqs")}</span>
          <span class="service-short">{bn ? "খরচ, সময়, পেমেন্ট, এলাকা — সব উত্তর" : "Cost, timing, payment, areas — all answered"}</span>
          <EpsIcon name="arrow" class="service-arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t(lang, "work")}</h2>
    </div>
    <WorkCarousel images={gallery} label={t(lang, "work")} lang={lang} />
    <div class="wrap">
      <p style="margin-top:16px"><a href={lp(lang, "/work/")}>{t(lang, "seeAll")} →</a></p>
    </div>
  </section>

  {(company.social.googleReview || company.social.googleBusiness) && (
    <section class="section">
      <div class="wrap center">
        <h2>{t(lang, "reviewsTitle")}</h2>
        <a class="btn btn-ghost" href={company.social.googleReview || company.social.googleBusiness} target="_blank" rel="noopener">{t(lang, "reviewsCta")} ↗</a>
      </div>
    </section>
  )}

</Base>
