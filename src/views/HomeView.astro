---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import CallButtons from "../components/CallButtons.astro";
import ServiceList from "../components/ServiceList.astro";
import AreaChips from "../components/AreaChips.astro";
import MapEmbed from "../components/MapEmbed.astro";
import SisterCard from "../components/SisterCard.astro";
import Faq from "../components/Faq.astro";
import JsonLd from "../components/JsonLd.astro";
import EpsIcon from "../components/EpsIcon.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import { company, telLink, waLink } from "../data/company";
import { orderNow, orderText } from "../data/order";
import { site, sister } from "../data/sites";
import { servicesFor } from "../data/services";
import { areas } from "../data/areas";
import { industries, businessBenefits } from "../data/industries";
import { generalFaqs } from "../data/faqs";
import { faqLd, graph } from "../lib/schema";
import { lp, num, pick, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const bn = lang === "bn";
const T = orderText[lang];
const all = servicesFor(site.key);
const homeList = all.filter((s) => s.group === "residential");
const homeServ = all.filter((s) => s.group === "home");
const sisterHome = servicesFor(sister.key).filter((s) => s.group !== "commercial");
const faqs = generalFaqs(site.key, lang);
const gallery = site.key === "electric"
  ? ["fan-install-1", "panel-3", "chandelier-1", "socket-2", "panel-room-1", "light-1", "panel-7", "drilling-2", "supershop-2"]
  : ["kitchen-sink", "commode-1", "tap-1", "pipe-1", "commode-2", "supershop-1", "socket-3", "supershop-3", "panel-room-2"];
const bizNeed = bn ? "প্রতিষ্ঠানের জন্য সাইট সার্ভে / প্রস্তাব" : "Site survey / proposal for our business";

const title = bn
  ? `${site.tradeBn} উত্তরা ও বসুন্ধরা — বাসা ও অফিস | ${company.nameBn}`
  : `${site.trade} in Uttara & Bashundhara — Home & Corporate | ${company.name}`;
const description = bn
  ? `উত্তরা, বসুন্ধরা ও আশেপাশে বাসা, অফিস ও প্রতিষ্ঠানের ${site.workBn} কাজ। হোয়াটসঅ্যাপে বুক করুন ${company.phone}।`
  : `${site.trade} for homes, offices and businesses in Uttara, Bashundhara and north Dhaka. Book on WhatsApp ${company.phone}.`;
---
<Base lang={lang} title={title} description={description} path="/">
  <JsonLd slot="head" data={graph(faqLd(faqs))} />

  <!-- First two sections: same format as emergencyeps.com (hero + "Choose a service") -->
  <section class="eps eps-hero">
    <div class="wrap hero-row">
      <div>
        <p class="tag"><EpsIcon name="clock" /> {T.open24}</p>
        <h1>{bn ? `${site.workBn} সমস্যায়, যেকোনো সময়` : `${site.work[0].toUpperCase()}${site.work.slice(1)} help, any time`}</h1>
        <p class="lead">{T.heroText}</p>
        <div class="btn-row">
          <a class="btn btn-green" href={waLink(orderNow.message[lang])} target="_blank" rel="noopener" data-track="whatsapp_order_now"
            data-order={JSON.stringify({ letters: orderNow.letters, service: "Order now", orderType: "Order now" })}>
            <EpsIcon name="whatsapp" /> {T.orderNow}
          </a>
          <a class="btn btn-line" href={telLink} data-track="call"><EpsIcon name="phone" /> {T.callUs}</a>
        </div>
      </div>
      <img class="hero-logo" src={company.logo} alt={bn ? company.nameBn : company.name} width="512" height="512" fetchpriority="high" />
    </div>
  </section>

  <section class="eps eps-section" id="choose">
    <div class="wrap">
      <h2>{T.chooseService}</h2>
      <ServiceGrid lang={lang} />
    </div>
  </section>

  <section class="section biz">
    <div class="wrap">
      <div class="biz-grid">
        <div>
          <p class="muted small" style="margin:0 0 6px">🏢 {t(lang, "corporate")}</p>
          <h2>{bn ? `প্রতিষ্ঠানের জন্য নির্ভরযোগ্য ${site.workBn} পার্টনার` : `A reliable ${site.work} partner for your business`}</h2>
          <p class="lead muted">
            {bn
              ? "অফিস, দোকান, রেস্টুরেন্ট, সুপার শপ, ক্লিনিক, স্কুল ও অ্যাপার্টমেন্ট বিল্ডিং — সাইট সার্ভে, লিখিত প্রস্তাব, অফিস সময়ের পরে কাজ এবং মাসিক রক্ষণাবেক্ষণ চুক্তি।"
              : "Offices, shops, restaurants, super shops, clinics, schools and apartment buildings — site surveys, written proposals, after-hours work and monthly maintenance contracts."}
          </p>
          <ul class="tiles">
            {industries.map((i) => (
              <li><a href={lp(lang, `/commercial/${i.slug}/`)}><span class="ic" aria-hidden="true">{i.icon}</span>{pick(lang, i.name, i.nameBn)}</a></li>
            ))}
          </ul>
          <CallButtons lang={lang} book={{ for: "commercial", s: bizNeed }} label={t(lang, "surveyWhatsapp")} />
        </div>
        <div class="biz-img"><Img name={site.commercialImage} sizes="(min-width: 900px) 50vw, 100vw" /></div>
      </div>
      <h3 style="margin-top:40px">{t(lang, "whyBusiness")}</h3>
      <ul class="benefits">
        {businessBenefits.map((b) => (
          <li><span class="ic" aria-hidden="true">{b.icon}</span><b>{bn ? b.bn : b.en}</b><p>{bn ? b.bnD : b.enD}</p></li>
        ))}
      </ul>
      <p style="margin-top:24px"><a href={lp(lang, "/commercial/")}>{bn ? "সব কর্পোরেট সার্ভিস দেখুন" : "See all corporate services"} →</a></p>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <h2 class="center">{t(lang, "howItWorks")}</h2>
      <div class="steps">
        {(["step1", "step2", "step3"] as const).map((k, i) => (
          <div class="step">
            <Img name={site.stepImages[i]} sizes="33vw" />
            <h3>{t(lang, k)}</h3>
            <p>{t(lang, `${k}d` as "step1d")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t(lang, "forHome")}</h2>
      <p class="muted">{t(lang, "noPriceNote")}</p>
      <ServiceList items={homeList} lang={lang} />
      <h3 style="margin-top:32px">{t(lang, "homeServices")}</h3>
      <ServiceList items={homeServ} lang={lang} />
      <h3 style="margin-top:32px" id={sister.key}>{sister.icon} {bn ? `${sister.workBn} সার্ভিস — আমাদের ${sister.divisionBn}` : `${sister.work[0].toUpperCase() + sister.work.slice(1)} services — by our ${sister.division}`}</h3>
      <ServiceList items={sisterHome} lang={lang} />
    </div>
  </section>

  <section class="section soft">
    <div class="wrap grid2">
      <div>
        <h2>{t(lang, "findUs")}</h2>
        <p>{bn
          ? `উত্তরা থেকে আমরা ${num(lang, areas.length)}টি এলাকায় সার্ভিস দিই।`
          : `From our base in Uttara we cover ${areas.length} areas across north Dhaka.`}</p>
        <AreaChips lang={lang} />
      </div>
      <div><MapEmbed lang={lang} query={`${company.name}, Uttara, Dhaka`} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{t(lang, "work")}</h2>
      <div class="gallery">
        {gallery.map((g) => <Img name={g} sizes="33vw" />)}
      </div>
      <p style="margin-top:16px"><a href={lp(lang, "/work/")}>{t(lang, "seeAll")} →</a></p>
    </div>
  </section>

  {company.social.googleBusiness && (
    <section class="section">
      <div class="wrap center">
        <h2>{t(lang, "reviewsTitle")}</h2>
        <a class="btn btn-ghost" href={company.social.googleBusiness} rel="noopener">{t(lang, "reviewsCta")} ↗</a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap"><SisterCard lang={lang} /></div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px">
      <Faq items={faqs} title={t(lang, "faqs")} />
      <div style="margin-top:24px"><CallButtons lang={lang} /></div>
    </div>
  </section>
</Base>
