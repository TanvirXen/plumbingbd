# Copy this file to .env and fill in the values:
#   cp .env.sample .env
# On Vercel: Project → Settings → Environment Variables — add the same keys there instead of using a .env file.

# Which website this folder builds. Do not change for this folder.
SITE_KEY=plumbing

# Live address of THIS website (no trailing slash). Used for canonical URLs, sitemap and structured data.
SITE_URL=https://www.plumbingservicebd.com

# Live address of the SISTER website. Every cross-link between the two sites uses this.
SISTER_URL=https://www.electricservicebd.com

# WhatsApp number that receives every booking: country code + number, no "+" or spaces.
WHATSAPP_NUMBER=8801609993537

# Phone number as shown on the site, and in international format for tap-to-call.
PHONE=01609-993537
PHONE_INTL=+8801609993537

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
GA_MEASUREMENT_ID=

# Optional: verification codes from Google Search Console and Bing Webmaster Tools (HTML-tag method, content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: Google Sheet for orders. Apps Script "Web app" URL (ends in /exec). Every WhatsApp order button
# then saves a row in the sheet and adds an Order ID (PS-301026-1) to the message. Leave empty to disable.
# Same URL on both sites. Setup: emergency-eps google-sheet folder (Emergency-EPS-Orders.xlsx + Code.gs).
GOOGLE_SHEET_WEBHOOK_URL=
